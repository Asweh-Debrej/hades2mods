# Each mod family under mods/ is its own git repository
/mods/

# Generated by tools/setup.ps1 (machine-specific)
/.defs/
/reference/
/.luarc.json

# Thunderstore CLI output
build/

# Python venv for tools/test.ps1 and tools/icons.ps1
/.venv/

# Game textures extracted by tools/icons.ps1 (copyrighted game files, never commit)
/.cache/
__pycache__/

# Files copied next to src/ by tools/link.ps1 so r2modman can load a linked package
/dev/*/src/manifest.json
/dev/*/src/icon.png
/dev/*/src/LICENSE
/dev/*/src/README.md
/dev/*/src/CHANGELOG.md
